# Notion integration token used by scripts/notion-publish.sh and scripts/publish-vision.sh
# notion-publish.sh also accepts it as NOTION_API_TOKEN.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Quiz Espresso: host screen key (also set it in Netlify → Site configuration → Environment variables)
QUIZ_HOST_KEY=change-me-long-random-string
# Base URL used by scripts/quiz-export.mjs and scripts/quiz-simulate.mjs
QUIZ_BASE_URL=http://localhost:8888
